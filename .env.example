# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Бесплатные модели через запятую: если первая перегружена, берётся следующая
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free
# Необязательно: id чата администратора, куда дублируются заявки (узнать у @userinfobot)
ADMIN_CHAT_ID=
# Необязательно: часовой пояс для даты в промпте
TIMEZONE=Asia/Almaty
# Необязательно: рассуждение модели. auto — только бронь и расчёты (по умолчанию), on — всегда, off — никогда
REASONING=auto
